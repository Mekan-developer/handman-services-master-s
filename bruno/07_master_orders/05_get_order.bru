meta {
  name: Get Order Details
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/master/orders/{{order_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

docs {
  # Get Single Order

  Full order details including the client's contact info, photos and tasks.
  Only readable once the order belongs to this master.

  **Response 200:**
  ```json
  {
    "data": {
      "id": 1,
      "status": "assigned",
      "client_name": "Merdan",
      "client_phone": "+99361234567",
      "address": "Ashgabat, Korogly 12",
      "latitude": 37.95,
      "longitude": 58.38,
      "category": "Сантехника",
      "description": "Сломался кран на кухне",
      "final_price": null,
      "photos": [
        { "id": 1, "url": "https://...", "status": "done" }
      ],
      "tasks": [],
      "assigned_at": "2026-05-16T10:05:00+05:00",
      "started_at": null,
      "completed_at": null,
      "created_at": "2026-05-16T10:00:00+05:00"
    }
  }
  ```

  **Errors:**
  - `404` — order not found or not assigned to this master
  - `403` — token has no usable master profile (see `reason`)
}
