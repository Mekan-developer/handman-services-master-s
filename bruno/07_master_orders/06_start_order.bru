  seq: 7
}

post {
  url: {{base_url}}/api/v1/master/orders/{{order_id}}/start
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

docs {
  # Start Order

  Changes order status: `assigned` → `in_progress`. Tasks can only be created
  and deleted inside this window.

  **Response 200:** `MasterOrderResource` (same shape as Get Order Details)
  with `status: "in_progress"` and `started_at` set.

  **Errors:**
  - `422` — order not in `assigned` status
  - `404` — order not assigned to this master
}
