meta {
  name: Delete Task
  type: http
  seq: 10
}

delete {
  url: {{base_url}}/api/v1/master/orders/{{order_id}}/tasks/{{task_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

docs {
  # Delete Task

  Deletes a task and all of its before/after photos (files removed from
  storage, `order_task_photos` rows cascade-deleted with the task).

  Allowed **only while the order is `in_progress`** — the same window as task
  creation. Once the order is completed or cancelled the task list becomes a
  fixed record.

  **Response 204:** empty body.

  **Errors:**
  - `422` — order is not `in_progress`
  - `404` — order/task not found, or not this master's
}
