meta {
  name: List My Orders
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/client/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

params:query {
  ~status: pending
}

docs {
  # List My Orders

  Paginated list of the authenticated client's orders. Optional `status` query
  filter — uncomment to scope: `pending`, `assigned`, `in_progress`,
  `completed`, `cancelled`.

  An account that also works as a master keeps the two sides separate: orders
  it **placed** live here, orders it **took** live in `07_master_orders`.

  **Response 200:**
  ```json
  {
    "data": [
      {
        "id": 1,
        "status": "pending",
        "status_label": "Новая",
        "description": "Кран в ванной течёт",
        "client_address": "ул. Атамырата Ниязова, д. 42",
        "client_lat": "37.9382000",
        "client_lng": "58.3833000",
        "final_price": null,
        "city": { "id": 5, "name": "Ашхабад" },
        "category": { "id": 2, "name": "Сантехника" },
        "master": null,
        "review": null,
        "assigned_at": null,
        "started_at": null,
        "completed_at": null,
        "cancelled_at": null,
        "created_at": "2026-05-16 10:00:00"
      }
    ],
    "links": { "...": "..." },
    "meta": { "current_page": 1, "last_page": 1, "per_page": 15, "total": 1 }
  }
  ```
}
