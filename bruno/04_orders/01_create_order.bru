meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/client/orders
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
  X-Locale: {{locale}}
}

body:multipart-form {
  city_id: {{city_id}}
  category_id: {{category_id}}
  description: Кран в ванной течёт, нужна замена прокладки и проверка сифона.
  client_phone: {{phone}}
  client_address: ул. Атамырата Ниязова, д. 42, кв. 17
  client_lat: 37.9382
  client_lng: 58.3833
  ~photos[]: @file()
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("order_id", res.body.data.id);
  }
}

docs {
  # Create Order

  Multipart form. Up to 4 photos may be attached as `photos[]` (uncomment to
  attach). The order is created with status `pending` and immediately enters
  the auto-search — nearby masters see it in `07_master_orders` → Available
  Orders. Photos are converted to WebP in the background via Queue.

  Saves the new order id into `{{order_id}}`, which the master folder reuses.

  **Required fields:**
  - `city_id`, `category_id`, `description`
  - `client_phone`, `client_address`, `client_lat`, `client_lng`

  **Optional:**
  - `photos[]` — up to 4 images (max 8 MB each)

  **Response 201:** `ClientOrderResource`

  **Errors:**
  - `422` — validation error
  - `403` — client profile incomplete (name or city_id missing)
}
