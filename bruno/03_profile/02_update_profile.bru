meta {
  name: Update Profile
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/v1/client/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
  Accept: application/json
  X-Locale: {{locale}}
}

body:json {
  {
    "name": "Merdan Annagurdow",
    "city_id": {{city_id}}
  }
}

docs {
  # Update Client Profile

  Both fields are optional (`sometimes`). Send only what needs to change.
  Required before the client can create orders (name + city_id must be set).

  This updates the **client** record only. An approved master profile keeps the
  name and city it was created with — the administrator edits those in the
  admin panel.

  **Response 200:** `ClientProfileResource`

  **Errors:**
  - `422` — validation error (e.g. city_id not found)
}
