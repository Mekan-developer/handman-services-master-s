PORT=3000
# 0.0.0.0 в Docker. На сервере без Docker — 127.0.0.1, наружу только /socket.io/ через nginx.
HOST=0.0.0.0
# Тот же секрет, что SMS_GATEWAY_SECRET в корневом .env и токен в настройках
# телефона (Socket.IO handshake: auth.token). Без него сервер не стартует.
OTP_SECRET=
# Имя события, которое слушает Flutter SMS-шлюз.
OTP_EVENT_NAME=otp
# Страница-тестер на GET /test. На проде держать false: любой, кто дотянулся
# до порта, сможет через неё слушать OTP-события, зная секрет.
ENABLE_TEST_PAGE=false
