# Порт, на котором слушает шлюз.
PORT=3000
# 0.0.0.0 — в Docker и когда телефон подключается к порту напрямую.
# 127.0.0.1 — если наружу шлюз отдаёт nginx (location /socket.io/) на той же машине.
HOST=0.0.0.0
# Общий секрет: то же значение, что OTP_SECRET в корневом .env Laravel
# и Auth Token в настройках телефона. Без него шлюз не стартует.
# Сгенерировать: openssl rand -hex 32
OTP_SECRET=
# Имя события, которое слушает телефон.
OTP_EVENT_NAME=otp
# Страница-тестер на GET /test. На проде держать false: это готовый
# слушатель OTP-кодов для любого, кто знает секрет.
ENABLE_TEST_PAGE=false
