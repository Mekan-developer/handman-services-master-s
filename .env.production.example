APP_NAME="HANDYMAN"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ashgabat
APP_URL=https://takykakym.com.tm/
COMPOSE_PROJECT_NAME=handyman
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

UID=1000
GID=1000

VITE_DEV_SERVER_HOST=192.168.31.157

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =========================
# DATABASE
# =========================

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=handyman_nury
DB_USERNAME=admin
DB_PASSWORD=secret

# =========================
# DOCKER
# =========================

COMPOSE_BAKE=false
# Зеркала для сборки образов. Пусто — официальные (deb.debian.org, packagist, npmjs).
# APT_MIRROR=http://deb.debian.org/debian
# COMPOSER_MIRROR=
# NPM_REGISTRY=https://registry.npmmirror.com/

# =========================
# SESSION
# =========================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# =========================
# BROADCAST / QUEUE
# =========================

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis

# =========================
# CACHE
# =========================

CACHE_STORE=redis
CACHE_PREFIX=

# =========================
# REDIS
# =========================

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================
# FILESYSTEM
# =========================

FILESYSTEM_DISK=local

# =========================
# MAIL
# =========================

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# =========================
# VITE
# =========================

VITE_APP_NAME="${APP_NAME}"

# =========================
# MAPS
# =========================

TILES_STYLE_URL="/maps/style.json"

MBTILES_PATH=maps/tiles.mbtiles

# =========================
# SMS GATEWAY
# =========================

SMS_DRIVER=modem
SMS_GATEWAY_URL=http://sms-gateway:3000
# Shared with the sms-gateway container and the phone's Auth Token: openssl rand -hex 32
OTP_SECRET=
SMS_DEVICE_LABEL=
OTP_TTL_MINUTES=2
OTP_EVENT_NAME=otp
ENABLE_TEST_PAGE=false

# =========================
# REVERB
# =========================

REVERB_APP_ID=422807
REVERB_APP_KEY=4liesygc2gk2bijxales
REVERB_APP_SECRET=rgdqxszaflu3p1ex39jb

REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=takykakym.com.tm
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https