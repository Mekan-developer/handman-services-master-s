# Глифы базовой карты: в репозитории только диапазоны 0-1279
# (латиница, латиница расширенная, кириллица) — этого хватает для tk/ru.
# Остальные ~110 МБ (в основном CJK) выкладываются на сервер отдельно.
/public/maps/fonts/**/*.pbf
!/public/maps/fonts/**/0-255.pbf
!/public/maps/fonts/**/256-511.pbf
!/public/maps/fonts/**/512-767.pbf
!/public/maps/fonts/**/768-1023.pbf
!/public/maps/fonts/**/1024-1279.pbf
