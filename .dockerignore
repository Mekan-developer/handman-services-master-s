.git
.gitignore
.gitattributes
node_modules
vendor
public/storage
# Если попадёт в образ — @vite будет грузить ассеты с dev-сервера.
public/hot

# Секреты и локальная конфигурация — .env монтируется в контейнер,
# а не копируется в образ.
.env
.env.*
!.env.example
storage/app/firebase
# Приватный TLS-ключ не должен попадать в слои образа: Caddy монтирует
# этот каталог томом в рантайме, копия внутри образа не нужна.
docker/caddy/certs

# Данные рантайма
storage/logs/*
storage/app/public/*
storage/app/temp/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Не нужно в прод-образе. Пути с ведущим слэшем — только в корне.
/tests
/bruno
/docs
.claude
.editorconfig
docker-compose*.yml
phpunit.xml
socket-server/node_modules
